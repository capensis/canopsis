{
  "name": "canopsis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxfmt lint:oxlint lint:eslint",
    "lint:oxfmt": "oxfmt --write \"src/**/*.{js,ts,cjs,mjs,jsx,tsx}\" --no-error-on-unmatched-pattern",
    "lint:oxlint": "run-s lint:oxlint:fix lint:oxlint:vue",
    "lint:oxlint:fix": "oxlint src --fix --ignore-pattern \"**/*.vue\" --no-error-on-unmatched-pattern",
    "lint:oxlint:vue": "oxlint src",
    "lint:eslint": "eslint . --fix --cache",
    "format": "run-s lint:oxfmt lint:eslint",
    "generate-icons-json": "node ./tools/generate-icons-json.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "axios": "^1.18.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "cytoscape": "^3.34.0",
    "cytoscape-cise": "^2.0.1",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-node-html-label": "^1.2.2",
    "dompurify": "^3.4.11",
    "file-saver": "^2.0.5",
    "flat": "^6.0.1",
    "handlebars": "^4.7.9",
    "jodit": "^4.12.27",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "leaflet.markercluster": "^1.5.3",
    "linkify-html": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lodash": "^4.18.1",
    "mermaid": "^9.4.3",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "moment-timezone": "^0.6.2",
    "monaco-editor": "^0.56.0",
    "monaco-mermaid": "^1.1.0",
    "monaco-themes": "^0.4.7",
    "pinia": "^3.0.4",
    "promised-handlebars": "^2.0.1",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.17.5",
    "tinycolor2": "^1.6.0",
    "uid": "^2.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.2",
    "vue-router": "^5.0.4",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "~10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "material-symbols": "^0.45.2",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,mts,cts,tsx}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix",
      "eslint --fix --cache"
    ],
    "*.vue": [
      "oxlint",
      "eslint --fix --cache"
    ],
    "*.{json,jsonc,css,scss,html,md}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
